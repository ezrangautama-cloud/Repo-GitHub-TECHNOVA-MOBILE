# Auto-detect text files and normalize line endings to LF
* text=auto

# Source code and config files should always use LF
*.kt text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.gradle text eol=lf
*.kts text eol=lf
*.properties text eol=lf
*.md text eol=lf
*.json text eol=lf

# Windows scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must use LF
gradlew text eol=lf
*.sh text eol=lf
